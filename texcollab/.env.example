# TeXCollab configuration. Copy to .env and adjust.
# Secrets (APP_SECRET, database password) live in ./secrets/, created by
# scripts/init-secrets.sh — never put them in this file.

# Externally visible URL (scheme + host [+ port]). Must match what users type
# in the browser: it is used for CSRF Origin checks and cookie security.
PUBLIC_URL=https://latex.example.org

# Number of reverse proxies in front of the app (1 with the bundled Caddy).
TRUST_PROXY_HOPS=1

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Optional first administrator, created only if there are no users yet.
# The password must be changed at first login. Remove after first start.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-immediately-please

# Sessions
SESSION_IDLE_TIMEOUT_MINUTES=10080
SESSION_ABSOLUTE_TIMEOUT_HOURS=720

# Brute-force protection
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=20

# Host port the app listens on
APP_PORT=3000
# Host address to bind: 127.0.0.1 = this machine only. 0.0.0.0 = reachable from
# the network over plain HTTP (trusted LAN tests only; PUBLIC_URL must then be
# http://<this machine's IP or name>:3000).
APP_BIND=127.0.0.1

# Group id of /var/run/docker.sock on the host (stat -c %g /var/run/docker.sock);
# lets the compile worker use Docker without running as root.
DOCKER_GID=999

# Compile workers (see docs/compilation.md)
COMPILE_MAX_CONCURRENCY=2
COMPILE_MAX_QUEUE=50
COMPILE_MAX_TIMEOUT_SECONDS=300
COMPILE_MAX_MEMORY_MB=4096
COMPILE_MAX_CPUS=4
# Optional: gVisor runtime for stronger sandboxing (install runsc on the host first)
COMPILE_DOCKER_RUNTIME=
# TeX Live base image for the sandbox (pin a dated tag for reproducible builds)
TEXLIVE_BASE_IMAGE=texlive/texlive:latest-full

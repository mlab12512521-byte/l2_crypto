# TeXCollab configuration. Copy to .env and adjust.
# Secrets (APP_SECRET, database password) live in ./secrets/, created by
# scripts/init-secrets.sh — never put them in this file.

# Externally visible URL (scheme + host [+ port]). Must match what users type
# in the browser: it is used for CSRF Origin checks and cookie security.
PUBLIC_URL=https://latex.example.org

# Number of reverse proxies in front of the app (1 with the bundled Caddy).
TRUST_PROXY_HOPS=1

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Optional first administrator, created only if there are no users yet.
# The password must be changed at first login. Remove after first start.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-immediately-please

# Sessions
SESSION_IDLE_TIMEOUT_MINUTES=10080
SESSION_ABSOLUTE_TIMEOUT_HOURS=720

# Brute-force protection
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=20

# Host port the app listens on (localhost only)
APP_PORT=3000

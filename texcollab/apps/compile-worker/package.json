{
  "name": "@texcollab/compile-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs LaTeX compilations in isolated, ephemeral Docker containers",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@texcollab/shared": "*"
  }
}
